.DEFAULT_GOAL := all

BUILD_TYPE ?= Debug
CMAKE_FLAGS ?=
CMAKE_BUILD_DIR = build

ifeq ($(DEBUG), true)
  BUILD_TYPE := Debug
endif
ifeq ($(RELEASE), true)
  BUILD_TYPE := Release
endif

all: clean-all build

setup:
	cmake -B $(CMAKE_BUILD_DIR) -G Ninja -DCMAKE_BUILD_TYPE=$(BUILD_TYPE) $(CMAKE_FLAGS)

check-setup:
	@if [ ! -d $(CMAKE_BUILD_DIR) ]; then \
		echo "Setting up build directory with Ninja..."; \
		make -f "Makefile.cmake-ninja" setup; \
	fi

build: check-setup
	cmake --build $(CMAKE_BUILD_DIR)

clean:
	rm -rf $(CMAKE_BUILD_DIR) access.log

clean-all: clean flatpak-clean
	rm -rf docs/html

reset: clean-all build

develop:
	@if [ -z "$$IS_NIX_SHELL" ]; then nix develop; else echo "Already in nix shell"; fi

test: check-setup
	cmake --build $(CMAKE_BUILD_DIR) && cd build && ctest --output-on-failure

test-unit: check-setup
	cmake --build $(CMAKE_BUILD_DIR) --target test_unit && cd build && ctest -L unit --output-on-failure

test-api: check-setup
	cmake --build $(CMAKE_BUILD_DIR) --target test_api  & cd build && ctest -L api --output-on-failure

test-cli: check-setup
	cmake --build $(CMAKE_BUILD_DIR) && cd build && ctest -L cli --output-on-failure

run-cli: build
	./$(CMAKE_BUILD_DIR)/github_user_fetcher

run-cli-server: build
	./$(CMAKE_BUILD_DIR)/github_user_fetcher --server

run-server: run-cli-server

run-gui: build
	cmake --build $(CMAKE_BUILD_DIR) --target github_user_fetcher_gui && ./$(CMAKE_BUILD_DIR)/github_user_fetcher_gui

cli: run-cli
cli-server: run-cli-server
server: cli-server
gui: run-gui

compile-commands:
	@cmake -B $(CMAKE_BUILD_DIR) -G Ninja -DCMAKE_BUILD_TYPE=$(BUILD_TYPE) -DCMAKE_EXPORT_COMPILE_COMMANDS=ON $(CMAKE_FLAGS)
	cp $(CMAKE_BUILD_DIR)/compile_commands.json .

lint: lint-clang-tidy lint-cppcheck lint-flawfinder

lint-clang-tidy: compile-commands
	@echo "Running clang-tidy..."
	@find src -name "*.c" -o -name "*.cpp" -o -name "*.h" -o -name "*.hpp" | xargs -r clang-tidy -p .

lint-cppcheck:
	@echo "Running cppcheck..."
	cppcheck --enable=all --error-exitcode=1 --suppress=unusedStructMember --suppress=missingIncludeSystem --inline-suppr --quiet --check-level=exhaustive -I./src $(wildcard src/*.[ch]pp src/*.[ch])

lint-flawfinder:
	@echo "Running flawfinder (security check)..."
	flawfinder --minlevel=1 $(wildcard src/*.[ch]pp src/*.[ch] benchmarks/*.[ch]pp)

lint-fix:
	find src -name "*.c" -o -name "*.cpp" -o -name "*.h" -o -name "*.hpp" | xargs -r clang-tidy -fix -fix-errors -p .

format:
	@echo "Formatting code with clang-format..."
	find src tests benchmarks -name "*.[ch]pp" -o -name "*.[ch]" | xargs clang-format -i -style=file
	@echo "Code formatting complete."

format-check:
	@echo "Checking code formatting..."
	find src tests benchmarks -name "*.[ch]pp" -o -name "*.[ch]" | xargs -I{} bash -c 'clang-format -style=file {} | diff --color=always -u {} - || printf "\033[31m=> File {} needs formatting\033[0m\n"'

docker-build-image:
ifeq ($(RELEASE), true)
	nix build .#dockerProductionImage
else
	nix build .#dockerImage
endif

docker-run-cli: docker-build-image
	sudo docker load < ./result
	sudo docker run -it --rm github_user_fetcher github_user_fetcher

docker-run-cli-user: docker-build-image
	sudo docker load < ./result
	sudo docker run -it --rm github_user_fetcher github_user_fetcher --user izelnakri

docker-run-cli-server: docker-build-image
	sudo docker load < ./result
	sudo docker run -it --rm -p 1234:1234 --init github_user_fetcher github_user_fetcher --server

docker-run-gui: docker-build-image
	sudo docker load < ./result
	sudo docker run -it --rm \
		--user $(shell id -u):$(shell id -g) \
		-e DISPLAY=$(DISPLAY) \
		-e DBUS_SESSION_BUS_ADDRESS=$(DBUS_SESSION_BUS_ADDRESS) \
		-v /etc/machine-id:/etc/machine-id:ro \
		-v /run/user/1000/bus:/run/user/1000/bus \
		-v /etc/fonts:/etc/fonts:ro \
		-v ~/.cache/fontconfig:/.cache/fontconfig \
		--device /dev/dri \
		--group-add $(shell getent group video | cut -d: -f3) \
		--ipc=host \
		--net=host \
		github_user_fetcher github_user_fetcher_gui

docker-debug: docker-build-image
	sudo docker load < ./result
	sudo docker run -it --rm github_user_fetcher zsh

debug:
	@echo "CMAKE_FLAGS: $(CMAKE_FLAGS)"
	@echo "BUILD_TYPE: $(BUILD_TYPE)"

doc:
	@echo "Generating documentation..."
	@chmod +x docs/build.sh
	@./docs/build.sh
	@echo "Opening documentation in Brave..."
	@brave docs/html/index.html || echo "Failed to open documentation in Brave"

bench: clean
	cmake -B $(CMAKE_BUILD_DIR) -G Ninja -DCMAKE_BUILD_TYPE=$(BUILD_TYPE) -DBUILD_BENCHMARKS=ON
	cmake --build $(CMAKE_BUILD_DIR) --target benchmarks
	cd $(CMAKE_BUILD_DIR) && ctest -L benchmark

bench-user:
	cmake --build $(CMAKE_BUILD_DIR) --target benchmarks
	./$(CMAKE_BUILD_DIR)/benchmarks

valgrind-cli: build
	valgrind --leak-check=full --show-leak-kinds=all --track-origins=yes --verbose ./$(CMAKE_BUILD_DIR)/github_user_fetcher

valgrind-cli-server: build
	valgrind --leak-check=full --show-leak-kinds=all --track-origins=yes --verbose ./$(CMAKE_BUILD_DIR)/github_user_fetcher --server

valgrind-gui: build
	valgrind --leak-check=full --show-leak-kinds=all --track-origins=yes --verbose ./$(CMAKE_BUILD_DIR)/github_user_fetcher_gui

valgrind-callgrind: build
	valgrind --tool=callgrind ./$(CMAKE_BUILD_DIR)/github_user_fetcher
	@echo "Use 'kcachegrind callgrind.out.*' to visualize the call graph"

valgrind-cachegrind: build
	valgrind --tool=cachegrind ./$(CMAKE_BUILD_DIR)/github_user_fetcher
	@echo "Use 'kcachegrind cachegrind.out.*' to visualize the cache profile"

valgrind-massif: build
	valgrind --tool=massif ./$(CMAKE_BUILD_DIR)/github_user_fetcher
	@echo "Use 'ms_print massif.out.*' to view heap profile"

heaptrack: build
	heaptrack ./$(CMAKE_BUILD_DIR)/github_user_fetcher --user izelnakri

release:
	@echo "Building in RELEASE mode with Ninja"
	make -f "Makefile.cmake-ninja" BUILD_TYPE=Release setup
	make -f "Makefile.cmake-ninja" build

install: release
	cd $(CMAKE_BUILD_DIR) && sudo cmake --install .

uninstall:
	@if [ -f $(CMAKE_BUILD_DIR)/install_manifest.txt ]; then \
		sudo xargs rm -f < $(CMAKE_BUILD_DIR)/install_manifest.txt; \
	else \
		echo "No install manifest found. Cannot uninstall."; \
	fi

flatpak-clean:
	rm -rf .flatpak-builder $(CMAKE_BUILD_DIR) flatpak/build flatpak/nix-environment-dependencies.tar.gz

flatpak-prepare-build:
	sh flatpak/bundle-nix-environment-dependencies.sh

flatpak-builder:
	flatpak-builder flatpak/build flatpak/manifest.json --force-clean

flatpak-build: flatpak-clean flatpak-prepare-build flatpak-builder

flatpak-install:
	flatpak build-export local-flatpak-repo flatpak/build
	flatpak remote-add --user --no-gpg-verify local-last-exported-flatpak-remote ./local-flatpak-repo
	flatpak install --user local-last-exported-flatpak-remote org.example.GithubUserFetcher

flatpak-run-cli: flatpak-build
	echo "Running manifest.json CLI:"
	flatpak-builder --run flatpak/build flatpak/manifest.json github_user_fetcher

flatpak-run-cli-server: flatpak-build
	echo "Running manifest.json CLI server:"
	flatpak-builder --run flatpak/build flatpak/manifest.json github_user_fetcher --server

flatpak-run-gui: flatpak-build
	echo "Running manifest.json GUI:"
	flatpak-builder --run flatpak/build flatpak/manifest.json github_user_fetcher_gui

run-flatpak: flatpak-run-gui
